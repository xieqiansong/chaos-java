<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>lan.chaos</groupId>
        <artifactId>jdk8-platform</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jdk8-sentinel-demo</artifactId>
    <packaging>jar</packaging>
    <name>jdk8-sentinel-demo</name>
    <description>Sentinel 流量防卫兵 Demo：流控/熔断降级/热点参数限流/注解式资源定义</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Sentinel 核心 + Spring Cloud Alibaba 集成（含注解 AOP 支持） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>

        <!-- Sentinel 规则 Nacos 持久化（生产必选，默认关闭，配置见 application.yml）
             说明：本仓库当前为离线构建，官方 sentinel-datasource-nacos 适配包未被缓存，
             故复用已就绪的 sentinel-core 的 datasource SPI + 已缓存的 nacos-client，
             自行实现轻量 NacosDataSource（见 common/config/NacosRuleDataSource）。
             联网环境可直接改回官方依赖：com.alibaba.csp.sentinel:sentinel-datasource-nacos:1.8.6 -->
        <dependency>
            <groupId>com.alibaba.nacos</groupId>
            <artifactId>nacos-client</artifactId>
            <version>1.4.2</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
