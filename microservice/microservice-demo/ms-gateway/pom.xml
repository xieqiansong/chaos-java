<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>lan.chaos</groupId>
        <artifactId>jdk8-microservice-demo</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jdk8-ms-gateway</artifactId>
    <packaging>jar</packaging>
    <name>jdk8-ms-gateway</name>
    <description>网关：路由转发、集中鉴权、限流、链路起点（WebFlux，不依赖 spring-boot-starter-web）</description>

    <dependencies>
        <dependency>
            <groupId>lan.chaos</groupId>
            <artifactId>jdk8-ms-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>lan.chaos</groupId>
            <artifactId>jdk8-ms-common-log</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- P6 Nacos Config：网关也接入配置中心，统一多环境管理 + 动态刷新（如限流阈值） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- Spring Cloud 2021.0.x 起 bootstrap 上下文默认关闭，需显式引入该 starter
             才能加载 bootstrap.yml（Nacos Config 的经典接入方式） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>

        <!-- Sentinel 核心（transport 接 Dashboard） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>

        <!-- Sentinel 网关适配：SentinelGatewayFilter / SentinelGatewayBlockExceptionHandler / GatewayRuleManager -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-alibaba-sentinel-gateway</artifactId>
        </dependency>

        <!-- P4 网关集中鉴权：复用 common-security 的 JwtProvider 本地验签（provided 作用域，不传递 webmvc，避免与 WebFlux 冲突） -->
        <dependency>
            <groupId>lan.chaos</groupId>
            <artifactId>jdk8-ms-common-security</artifactId>
        </dependency>

        <!-- 路由 lb://ms-user 需要的客户端负载均衡 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 单元测试（P2 限流规则断言）。网关是 WebFlux，仅引入 junit-jupiter 避免 spring-boot-starter-test
             顺带拉入 spring-webmvc 与 WebFlux 冲突 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
