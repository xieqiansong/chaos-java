<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>lan.chaos</groupId>
        <artifactId>jdk8-microservice-demo</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>jdk8-ms-common-feign</artifactId>
    <packaging>jar</packaging>
    <name>jdk8-ms-common-feign</name>
    <description>Feign 公共支撑：Sentinel 熔断降级工厂基类、traceId/Authorization 透传拦截器</description>

    <dependencies>
        <dependency>
            <groupId>lan.chaos</groupId>
            <artifactId>jdk8-ms-common-core</artifactId>
        </dependency>

        <!-- P5：透传 Authorization 头时复用 SecurityConstants 里的头名常量，避免与 P4 安全基座“各写一份” -->
        <dependency>
            <groupId>lan.chaos</groupId>
            <artifactId>jdk8-ms-common-security</artifactId>
        </dependency>

        <!-- OpenFeign：声明式 HTTP 客户端 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- Sentinel：feign.sentinel.enabled=true 后接管 Feign，提供熔断/降级 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>

        <!-- FallbackFactory 接口所在包（OpenFeign 降级兜底需要，Hystrix 运行时本身不启用） -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-hystrix</artifactId>
        </dependency>

        <!-- 透传入口请求的 Authorization 头需要 Servlet API 与 Spring WebMVC 的 ServletRequestAttributes -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
