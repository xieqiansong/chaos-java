<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>lan.chaos</groupId>
        <artifactId>chaos-parent-jdk8</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../chaos-parents/chaos-parent-jdk8/pom.xml</relativePath>
    </parent>

    <artifactId>finance-demo</artifactId>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.boot.version>2.7.18</spring.boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>lan.chaos</groupId>
                <artifactId>chaos-dependencies-spring-boot2</artifactId>
                <version>1.0-SNAPSHOT</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot 核心（非 Web，仅承载 ApplicationRunner 演示与后续能力包） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Lombok：实体类样板精简（编译期，provided） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 测试：JUnit5 + AssertJ + Mockito 由 spring-boot-starter-test 收口 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <configuration>
                    <!--
                      WHY：repackage 默认会替换主 artifact 为 fat jar（类被挪进 BOOT-INF/classes），
                      导致 verify 阶段 failsafe 执行 *IT 时找不到业务类（NoClassDefFoundError）。
                      加 classifier 后可执行 jar 单独产出为 *-exec.jar，主 jar 保持普通 jar，
                      单测与集成测试 classpath 均正常。
                    -->
                    <classifier>exec</classifier>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
