<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>lan.chaos</groupId>
        <artifactId>jdk8-microservice-demo</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jdk8-ms-order</artifactId>
    <packaging>jar</packaging>
    <name>jdk8-ms-order</name>
    <description>订单服务：创建 / 查询，Feign 编排调 user（演示跨服务 + Seata，P1/P3 落地）</description>

    <dependencies>
        <dependency>
            <groupId>lan.chaos</groupId>
            <artifactId>jdk8-ms-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>lan.chaos</groupId>
            <artifactId>jdk8-ms-common-log</artifactId>
        </dependency>
        <dependency>
            <groupId>lan.chaos</groupId>
            <artifactId>jdk8-ms-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>lan.chaos</groupId>
            <artifactId>jdk8-ms-common-feign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- OpenFeign：声明式调用 user 服务 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- Sentinel：feign.sentinel.enabled=true 接管 Feign 熔断/降级 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>

        <!-- 服务发现下的客户端负载均衡（@FeignClient("ms-user") 需要 lb:// 解析） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- FallbackFactory 接口所在包 -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-hystrix</artifactId>
        </dependency>

        <!-- 单元测试（P2 Feign 降级断言），order 是 WebMVC 无 WebFlux 冲突 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
