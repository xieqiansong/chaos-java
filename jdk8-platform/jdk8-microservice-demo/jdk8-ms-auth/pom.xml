<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>lan.chaos</groupId>
        <artifactId>jdk8-microservice-demo</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jdk8-ms-auth</artifactId>
    <packaging>jar</packaging>
    <name>jdk8-ms-auth</name>
    <description>P4 鉴权服务：登录签发 JWT（access+refresh）、刷新、登出吊销（refresh 存 Redis 可吊销）</description>

    <dependencies>
        <dependency>
            <groupId>lan.chaos</groupId>
            <artifactId>jdk8-ms-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>lan.chaos</groupId>
            <artifactId>jdk8-ms-common-log</artifactId>
        </dependency>
        <!-- P4 安全基座：JwtProvider / LoginUser / SecurityConstants -->
        <dependency>
            <groupId>lan.chaos</groupId>
            <artifactId>jdk8-ms-common-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 参数校验 @Valid / @NotBlank -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Redis：存刷新令牌（可吊销）；缺省用内存实现兜底，demo 也能跑 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
