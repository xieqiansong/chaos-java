    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>5.13.4</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!-- 压测专用：只跑 *Bench / BenchMarkTest，其余单测让位 -->
        <profile>
            <id>stress</id>
            <properties>
                <surefire.include1>**/*Bench.java</surefire.include1>
                <surefire.include2>**/BenchMarkTest.java</surefire.include2>
                <bench.exclude>**/NoSuchBench.java</bench.exclude>
            </properties>
        </profile>
    </profiles>
