<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
    <groupId>lan.chaos</groupId>
    <artifactId>chaos-parent-jdk8</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../../chaos-parents/chaos-parent-jdk8/pom.xml</relativePath>
</parent>
    <dependencyManagement><dependencies><dependency><groupId>lan.chaos</groupId><artifactId>chaos-dependencies-spring-boot2</artifactId><version>1.0-SNAPSHOT</version><type>pom</type><scope>import</scope></dependency></dependencies></dependencyManagement>

    <artifactId>crypto-demo</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>crypto-demo</name>
    <description>主流加密算法全景：对称 / 非对称 / 摘要 / MAC / KDF / 国密 SM2-SM3-SM4</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- 国密与扩展算法（SM2/SM3/SM4、SHA-3、ChaCha20-Poly1305、Ed25519/X25519、HKDF）依赖 BouncyCastle 提供者。
             平台根 pom 未管理该版本，故此处显式声明；jdk18on 兼容 JDK8+ -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>lan.chaos.crypto.CryptoApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

